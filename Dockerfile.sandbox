# syntax=docker/dockerfile:1.7
#
# Test-runner sandbox. NOT a deployable image — `Dockerfile` is the production
# one and this never replaces it.
#
# Purpose: give `npm test` a filesystem that contains this repo and nothing else.
# No home directory, no sibling repos, no credentials. See docs/SANDBOX.md.
#
# The image carries the dependency tree and NO application source. Source is
# bind-mounted read-only at run time, so editing a file never invalidates a
# layer; the image rebuilds only when one of SANDBOX_LOCKFILES changes
# (package.json, package-lock.json, .npmrc, this file).

FROM node:22-bookworm-slim

# Match the host user so anything written to a bind mount is owned by the
# developer, not by root. Overridden per-machine by scripts/sandbox.sh.
ARG HOST_UID=501
ARG HOST_GID=20
RUN set -eux; \
    if ! getent group "${HOST_GID}" >/dev/null 2>&1; then \
      groupadd -g "${HOST_GID}" sandbox; \
    fi; \
    if ! getent passwd "${HOST_UID}" >/dev/null 2>&1; then \
      useradd -o -u "${HOST_UID}" -g "${HOST_GID}" -m -d /home/sandbox -s /bin/bash sandbox; \
    fi

WORKDIR /deps

# Only the dependency manifests. Application source is deliberately absent:
# nothing in this image should be able to execute repo code at build time.
COPY package.json package-lock.json .npmrc ./

# Dependency install. Two things make this the one phase that is allowed network
# access:
#
#   --ignore-scripts   no pre/post/install hook from any package runs, so no
#                      third-party code executes here at all. (The repo .npmrc
#                      sets ignore-scripts=true as well; passed explicitly so
#                      the guarantee does not depend on that file surviving.)
#   secret mount       the GitHub Packages token arrives on a tmpfs that exists
#                      for this RUN only. It is NEVER an ARG and NEVER an ENV:
#                      both of those are readable out of the finished image with
#                      `docker history` / `docker inspect`.
#
# The merged npmrc is assembled on a tmpfs mount, not on the layer filesystem,
# so the token cannot land in an image layer even transiently.
RUN --mount=type=secret,id=npmrc,target=/run/secrets/npmrc,uid=${HOST_UID} \
    --mount=type=tmpfs,target=/npmtmp \
    --mount=type=cache,target=/root/.npm,sharing=locked \
    set -eu; \
    cat .npmrc > /npmtmp/npmrc; \
    if [ -s /run/secrets/npmrc ]; then \
      if grep -q '_authToken' /run/secrets/npmrc; then \
        grep -E '^//.*:_authToken=' /run/secrets/npmrc >> /npmtmp/npmrc; \
      else \
        { printf '//npm.pkg.github.com/:_authToken='; cat /run/secrets/npmrc; echo; } \
          >> /npmtmp/npmrc; \
      fi; \
    fi; \
    npm_config_userconfig=/npmtmp/npmrc \
    npm ci --ignore-scripts --legacy-peer-deps; \
    npm_config_userconfig=/npmtmp/npmrc npm cache clean --force >/dev/null 2>&1 || true

# Prove the token did not survive the RUN above. If a future edit reintroduces
# it as an ARG/ENV or writes it to a layer, the build fails here rather than
# shipping a credential-bearing image.
# Matches a token with an actual VALUE, on a line that is not a comment.
# Two things that are NOT leaks and must not fail the build:
#   - a committed `_authToken=${NODE_AUTH_TOKEN}` placeholder (design-system
#     ships one), hence the exclusion of values starting with `$`
#   - prose ABOUT the setting: tokenbot-cli's .npmrc carries a comment reading
#     "deliberately no //npm.pkg.github.com/:_authToken=... line here", which a
#     naive grep flags as a credential.
RUN set -eu; \
    if [ -f /deps/.npmrc ] && grep -v '^[[:space:]]*#' /deps/.npmrc \
         | grep -qE '_authToken=[^$[:space:]]'; then \
      echo "FATAL: auth token persisted into an image layer" >&2; exit 1; \
    fi; \
    if env | grep -qi 'authToken\|NODE_AUTH'; then \
      echo "FATAL: auth token present in image environment" >&2; exit 1; \
    fi

# node_modules ends up at /deps/node_modules. scripts/sandbox.sh copies it into
# a named volume and mounts that read-only at /node_modules — the container
# root, not /work/node_modules, because Docker cannot create a mountpoint inside
# the read-only source bind. Node resolves modules by walking up from the
# importing file, so /node_modules serves everything under /work.

# Cache directories the toolchain writes to INSIDE node_modules. They have to
# exist here so that scripts/sandbox.sh can mount a tmpfs over each one at run
# time: Docker refuses to create a mountpoint under a read-only mount, so a
# directory that is missing here produces a cryptic
#   ENOENT: no such file or directory, mkdir '/node_modules/.vite-temp'
# instead of a working suite. This list and SANDBOX_SCRATCH_DIRS in
# scripts/sandbox.conf must agree.
RUN mkdir -p /deps/node_modules/.vite-temp \
             /deps/node_modules/.vite \
             /deps/node_modules/.cache \
    && chown -R ${HOST_UID}:${HOST_GID} /deps

USER ${HOST_UID}:${HOST_GID}
ENV HOME=/tmp \
    npm_config_update_notifier=false \
    npm_config_fund=false \
    npm_config_audit=false
WORKDIR /work

# No CMD: this image is only ever started by scripts/sandbox.sh, which states
# the command explicitly. A default that "runs the tests" invites a bare
# `docker run` that silently skips the network and mount hardening.

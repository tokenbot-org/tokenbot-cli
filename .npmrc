# The three @tokenbot-org/* build-time dependencies are published to GitHub
# Packages, not public npm. Without this mapping, `npm install` resolves them
# against registry.npmjs.org and 404s.
@tokenbot-org:registry=https://npm.pkg.github.com

# NOTE: deliberately no `//npm.pkg.github.com/:_authToken=...` line here.
# Committing one that interpolates an env var would override a developer's
# working global auth with an empty string whenever that variable is unset,
# turning a working local install into a 401. CI supplies auth via
# actions/setup-node (registry-url + NODE_AUTH_TOKEN); local developers use
# their own ~/.npmrc. See CONTRIBUTING.md.

# Shai-Hulud hardening: never run dependency lifecycle (pre/post-install)
# scripts. Blocks malicious postinstall payloads. Carried over from the
# monorepo this package was extracted from. If a genuine native build ever
# needs one, allow-list it with an explicit, reviewed `npm rebuild <pkg>` step.
ignore-scripts=true

# Parity with the monorepo's resolution behaviour.
legacy-peer-deps=true
